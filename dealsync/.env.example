DJANGO_SETTINGS_MODULE=dealsync.settings.dev
SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=dealsync_db
